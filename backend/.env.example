# Backend runtime
# PORT la port UU TIEN. Neu port nay dang bi chiem (EADDRINUSE), backend tu tim
# port trong ke tiep trong danh sach: 7000, 7001, 7002, 7003, 7004, 7005, 7010, 7100.
# Port thuc te backend dang chay duoc ghi vao runtime/backend-port.json.
PORT=7000
HOST=127.0.0.1

# CORS cho frontend web/electron nếu cần
# KHA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5174

# MySQL thật cho settings xuất âm tồn kho và module mẫu in hóa đơn (/api/print-templates)
# Backend tự migrate an toàn bảng system_settings để lưu negative_stock_limit; nếu chưa cấu hình MySQL thì dùng JSON fallback và vẫn tiếp tục chạy.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=phanmienoffline

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=phanmienoffline

# Có thể dùng namespace riêng cho settings xuất âm nếu không muốn dùng MYSQL_* chung
# KHA_SETTINGS_MYSQL_HOST=127.0.0.1
# KHA_SETTINGS_MYSQL_PORT=3306
# KHA_SETTINGS_MYSQL_USER=root
# KHA_SETTINGS_MYSQL_PASSWORD=
# KHA_SETTINGS_MYSQL_DATABASE=phanmienoffline

# Có thể dùng namespace riêng cho module mẫu in nếu không muốn dùng MYSQL_* chung
# KHA_PRINT_TEMPLATES_MYSQL_HOST=127.0.0.1
# KHA_PRINT_TEMPLATES_MYSQL_PORT=3306
# KHA_PRINT_TEMPLATES_MYSQL_USER=root
# KHA_PRINT_TEMPLATES_MYSQL_PASSWORD=
# KHA_PRINT_TEMPLATES_MYSQL_DATABASE=phanmienoffline

# Tùy chọn pool MySQL cho settings và mẫu in hóa đơn
# SETTINGS_MYSQL_CONNECTION_LIMIT=5
# SETTINGS_MYSQL_CONNECT_TIMEOUT_MS=3000
# KHA_SETTINGS_MYSQL_CONNECTION_LIMIT=5
# KHA_SETTINGS_MYSQL_CONNECT_TIMEOUT_MS=3000
# PRINT_TEMPLATES_MYSQL_CONNECTION_LIMIT=5
# PRINT_TEMPLATES_MYSQL_CONNECT_TIMEOUT_MS=3000
# KHA_PRINT_TEMPLATES_MYSQL_CONNECTION_LIMIT=5
# KHA_PRINT_TEMPLATES_MYSQL_CONNECT_TIMEOUT_MS=3000

# Có thể dùng URL thay cho bộ biến MYSQL_* nếu muốn
# MYSQL_URL=mysql://root:password@127.0.0.1:3306/phanmienoffline
# KHA_SETTINGS_MYSQL_URL=mysql://root:password@127.0.0.1:3306/phanmienoffline
# KHA_PRINT_TEMPLATES_MYSQL_URL=mysql://root:password@127.0.0.1:3306/phanmienoffline

# Read-only MCP bridge for local AI tools. It uses the existing authenticated API,
# never connects to the database directly, and only permits GET requests.
# Export a short-lived login token in your terminal instead of saving it in .env.
# KHA_MCP_API_BASE=http://127.0.0.1:7000/api
# KHA_MCP_AUTH_TOKEN=
# KHA_MCP_REQUEST_TIMEOUT_MS=10000
