# Desktop/dev backend connection.
# VITE_BACKEND_PORT la port UU TIEN. Backend co the chay o port khac neu 7000 bi chiem.
# Frontend tu probe /api/health tren cac port 7000-7100 de tim backend dang chay,
# hoac doc runtime/backend-port.json. Khong can hardcode port 7000.
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=7000

# Mobile builds must use a backend URL reachable from Android and iPhone.
VITE_API_BASE_URL=https://api.example.com/api
