{
  "name": "phanmienoffline-electron",
  "version": "1.3.4",
  "description": "Bán hàng offline ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vankhadev/phanmemoffline.git"
  },
  "homepage": "https://github.com/Vankhadev/phanmemoffline#readme",
  "bugs": {
    "url": "https://github.com/Vankhadev/phanmemoffline/issues"
  },
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "set KHA_BACKEND_HOST=127.0.0.1&& npm --prefix backend start",
    "dev:frontend": "set VITE_BACKEND_HOST=127.0.0.1&& set VITE_BACKEND_PORT=%KHA_BACKEND_PORT%&& npm --prefix frontend run dev -- --host 127.0.0.1 --port 5174 --strictPort",
    "dev:electron": "set ELECTRON_DEV_URL=http://127.0.0.1:5174&& electron .",
    "reset-local-admin": "npm --prefix backend run reset-local-admin --",
    "sync:desktop-icon": "node scripts/sync-desktop-icon.js",
    "build:frontend": "cd frontend && npm run build",
    "package:portable": "npm run sync:desktop-icon && electron-builder --win portable --publish never",
    "package:installer": "npm run sync:desktop-icon && electron-builder --win nsis --publish never",
    "build:portable": "npm run build:frontend && npm run package:portable",
    "build:installer": "npm run build:frontend && npm run package:installer",
    "build:electron": "npm run build:installer",
    "build": "npm run build:installer",
    "build:all": "npm run build:frontend && npm run sync:desktop-icon && electron-builder --win portable nsis --publish never",
    "generate:update-manifest": "node scripts/generate-update-manifest.js"
  },
  "build": {
    "appId": "com.vankhammo.phanmienoffline",
    "productName": "Ban hang offline - Van kha mmo",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "backend/**/*",
      "!backend/phanmienoffline.db.json",
      "!**/*.db",
      "!**/*.db.json",
      "!**/*.sql",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/app-icon.png",
        "to": "icons/app-icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/app-icon.ico"
    },
    "mac": {
      "icon": "build/icons/app-icon.icns"
    },
    "linux": {
      "icon": "build/icons/app-icon.png"
    },
    "portable": {
      "artifactName": "BanHangOffline_v${version}.exe"
    },
    "nsis": {
      "artifactName": "banhangoffline-setup-v${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ban hang offline - Van kha mmo"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Vankhadev/phanmemoffline/releases/latest/download/",
        "channel": "latest"
      }
    ],
    "asar": true
  },
  "khaUpdate": {
    "provider": "github",
    "owner": "Vankhadev",
    "repo": "phanmemoffline",
    "latestYmlUrl": "https://github.com/Vankhadev/phanmemoffline/releases/latest/download/latest.yml",
    "latestYmlBaseUrl": "https://github.com/Vankhadev/phanmemoffline/releases/latest/download/",
    "manifestUrl": "https://github.com/Vankhadev/phanmemoffline/releases/latest/download/update-manifest.json",
    "assetBaseUrl": "https://github.com/Vankhadev/phanmemoffline/releases/download"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.2.2",
    "electron-builder": "^24.13.3"
  }
}
