# Dependencies
node_modules/
**/node_modules/

# Frontend/build output
frontend/dist/
dist/

# Keep Electron desktop icon source assets in build/ tracked for CI packaging.
# Do not ignore the whole build/ directory, because scripts/sync-desktop-icon.js
# requires build/icon.png, build/icon@2x.png, build/icon.ico and build/icon.icns.

# Electron/release artifacts generated by electron-builder or CI
release/*.exe
release/*.dmg
release/*.zip
release/*.AppImage
release/*.blockmap
release/*.exe.blockmap
release/latest.yml
release/builder-debug.yml
release/win-unpacked/
release/win-*-unpacked/
release/*-unpacked/
release/update-simulation/
release/update-manifest.json
!release/update-manifest.example.json

# Runtime databases and backups
phanmienoffline.db.json
phanmienoffline.db.json.backup*
*.db
*.db.json
*.sqlite
*.sqlite3
*.bak
*.backup
*.backup.*

# Logs, temp files, and caches
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.tmp/
.npm-cache/
.electron-cache/
.electron-builder-cache/
tmp/
temp/
coverage/
.nyc_output/

# Local environment and machine-specific config
.env
.env.*
!.env.example
*.local
.kha-session-secret
**/.kha-session-secret
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local assistant/tooling metadata
.claude/
.roo/

